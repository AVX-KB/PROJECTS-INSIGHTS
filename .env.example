# Kopieer naar .env en vul de waarden in. Een gevulde .env komt nooit in git.

# Wachtwoord van svc_projects_insights op AVX-AI-DB.
# KeePass: groep INFRA / DATABASES, item van deze omgeving.
DB_WACHTWOORD=<uit KeePass>

# Eén gedeeld wachtwoord om de pagina te openen.
# KeePass: de groep van Projects Insights (frontend-credential).
TOEGANGSWACHTWOORD=<uit KeePass>

# Fine-grained token van GitHub, alleen lezen (Projects, Issues, Pull requests).
# KeePass: groep API KEYS.
GITHUB_TOKEN=<uit KeePass>

# Het bord: github.com/orgs/<GITHUB_ORG>/projects/<GITHUB_PROJECT>
GITHUB_ORG=AVEXInternational
GITHUB_PROJECT=13

# Veldnamen op het bord, letterlijk zoals ze daar heten.
SPRINT_VELD=WEEK
STATUS_VELD=Status
# Keuzeveld voor prioriteit; elke waarde telt als "met prioriteit".
PRIO_VELD=Priority
# Statussen die tellen als afgerond, gescheiden door komma's.
AFGEROND_STATUSSEN=Done

# Tijdstippen van de momentopnamen (Europe/Amsterdam), gescheiden door komma's.
SNAPSHOT_TIJDEN=06:00,12:00,18:00
